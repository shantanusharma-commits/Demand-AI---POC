# DemandAI configuration. Copy to .env.local for development and fill in real values there.
# Never commit real values. Every variable is validated at start-up (lib/server/env.ts); a problem stops the
# server with a message that names the variable but never its value. Blank means "not set".

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public URL people open; required in production. Links in invite and reset emails use it.
APP_BASE_URL=http://localhost:3000
# Set by the image build; shown by /api/health so a redeploy can confirm the new code is live.
APP_BUILD_VERSION=dev
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Database statements slower than this are logged at warn.
LOG_SLOW_QUERY_MS=500
# Reverse proxies in front of the app that append to X-Forwarded-For (1 = one proxy such as Caddy, nginx or an
# AWS ALB; 2 = ALB then nginx). Used to find the client address for rate limits. The app must be reachable only
# through those proxies: a client that reaches it directly can name any address in X-Forwarded-For and so get a fresh
# per-address sign-in limit each time (the per-email limit and the lockout still hold). docs/SECURITY.md.
TRUSTED_PROXY_HOPS=1
NEXT_TELEMETRY_DISABLED=1

# ── Database (PostgreSQL 16) ─────────────────────────────────────────────────
# Runtime role (least privilege). Local Compose stack: 127.0.0.1:55432.
DATABASE_URL=postgresql://demandai_app:<app-password>@127.0.0.1:55432/demandai
# Owner role, used only by the migrate step.
DATABASE_MIGRATION_URL=postgresql://demandai_owner:<owner-password>@127.0.0.1:55432/demandai
# Ops role, used only by the data purge and export commands (npm run data:purge, data:export). Locally it may be
# left out: the commands then use DATABASE_URL's server with demandai_ops and DEMANDAI_OPS_PASSWORD.
DATABASE_OPS_URL=postgresql://demandai_ops:<ops-password>@127.0.0.1:55432/demandai
# disable (local only) | require | verify-full (production, with the provider's CA bundle)
DATABASE_SSL_MODE=disable
# Path to the CA bundle for verify-full, for example the AWS RDS global bundle.
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Used only by the Compose services. The db service creates the three DemandAI roles from these passwords on
# first start. Passwords: letters, digits, - and _ only (they go into connection URLs); openssl rand -hex 32.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<hex-password>
POSTGRES_DB=demandai
DEMANDAI_OWNER_PASSWORD=<hex-password>
DEMANDAI_APP_PASSWORD=<hex-password>
DEMANDAI_OPS_PASSWORD=<hex-password>
BACKUP_RETAIN=20
# Compose only: host port for the app (loopback), host port for the local database (compose.dev.yaml), image tag.
APP_PORT=3100
DB_PORT=55432
DEMANDAI_IMAGE=demandai-app:local

# ── Sessions ─────────────────────────────────────────────────────────────────
# At least 32 random characters, for example: openssl rand -base64 48
SESSION_SECRET=<random-48-bytes>
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=60

# ── Email for invites and password resets (SMTP, STARTTLS) ───────────────────
# 1 = never send; the Admin copies the one-time link from the screen instead.
NOTIFICATION_DISABLED=1
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_SENDER_NAME=DemandAI
NOTIFICATION_APP_PASSWORD=
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
SUPPORT_EMAIL=

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_ROWS=50000
UPLOAD_TIME_LIMIT_MS=60000
# An .xlsx may expand to at most this many bytes when unzipped (zip-bomb guard).
UPLOAD_MAX_UNZIPPED_BYTES=209715200

# Background jobs (upload checks, scoring). Each app instance runs a worker; set 0 to run one elsewhere.
JOBS_WORKER=1
JOBS_POLL_MS=1000

# ── AI ───────────────────────────────────────────────────────────────────────
# none | azure-openai | bedrock. With none, every capability uses its rule fallback.
AI_PROVIDER=none
AI_TIMEOUT_MS=30000
AI_MAX_CONCURRENCY=4
# Capability flags: off unless set to 1.
AI_FEATURE_DRAFTING=0
AI_FEATURE_WHY_NOW=0
AI_FEATURE_CLASSIFY=0
AI_FEATURE_COPILOT=0
AI_FEATURE_CONTENT_STUDIO=0
# Azure OpenAI (or an API Management gateway in front of it). A resource endpoint gets /openai added; an endpoint
# whose path already ends in /openai is used as it is. https only (http is accepted for 127.0.0.1 alone).
AZURE_OPENAI_ENDPOINT=https://<resource-or-gateway-host>/<path>
AZURE_OPENAI_API_KEY=
# The main model's deployment, and the small model's for the capabilities in AI_SMALL_MODEL_FOR (D-44).
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_DEPLOYMENT_SMALL=gpt-5.4-mini
# The newest dated version the pilot's API Management gateway serves (it doesn't expose the v1 API).
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# api-key (Azure OpenAI) | Ocp-Apim-Subscription-Key (some API Management front doors)
AZURE_OPENAI_AUTH_HEADER=api-key
# Amazon Bedrock: credentials come from the IAM role (EKS Pod Identity / IRSA, EC2 instance profile), never from here.
# With AI_PROVIDER=bedrock the app refuses to start if AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY is set.
AWS_REGION=
BEDROCK_MODEL_ID=
BEDROCK_MODEL_ID_SMALL=
# Capabilities that use the small model when one is set (classify, why_now, draft_message, draft_content, copilot).
AI_SMALL_MODEL_FOR=classify
# Reasoning effort per capability over each template's own, e.g. draft_message=medium,copilot=none (blank: the templates').
AI_REASONING_EFFORT=
# USD per million tokens, for the cost estimate kept with each call: gpt-5.4, then the small model gpt-5.4-mini
# (list prices; set your agreement's).
AI_PRICE_INPUT_PER_MTOK=2.5
AI_PRICE_OUTPUT_PER_MTOK=15
AI_PRICE_SMALL_INPUT_PER_MTOK=0.75
AI_PRICE_SMALL_OUTPUT_PER_MTOK=4.5
# 1 lets the optional live smoke test (tests/ai-live-smoke.test.ts) call the configured model. Never in CI.
AI_LIVE_SMOKE=0

# ── Local development only ───────────────────────────────────────────────────
# Password for the fictional users created by npm run db:seed (never used in production; the seed refuses it).
DEV_SEED_PASSWORD=

# ── Data lifecycle ───────────────────────────────────────────────────────────
# Days after the readout's sponsor decision when a unit's pilot data is due to be purged (D-20, provisional: set it
# from the Client contract). Read by npm run data:purge; -- --status shows when each unit is due.
RETENTION_DAYS_AFTER_READOUT=30
