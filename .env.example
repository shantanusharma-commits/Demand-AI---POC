# Copy to .env.local and fill in. Never commit the real file.

# Hunter.io API key for email verification (https://hunter.io/api-keys).
# Optional: a key saved in Setup -> Integrations is used first; this is the fallback.
HUNTER_API_KEY=

# Optional. Secret used to encrypt the key saved in Setup. If unset, a random one is created in the data folder.
# Set it in production so the key is not stored beside the secret that protects it.
SETTINGS_SECRET=

# Optional. Where the encrypted key and stored verification results are kept. Default: ./.data
DEMANDAI_DATA_DIR=
