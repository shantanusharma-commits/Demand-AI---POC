{
  "name": "demand-ai-poc",
  "private": true,
  "description": "DemandAI clickable prototype in Next.js; the lead and scoring rules live in lib/demandai-engine.ts",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server --test tests/*.test.ts",
    "test:legacy": "node --test legacy/engine.test.js",
    "test:integration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server --test --test-concurrency=4 tests/integration/*.test.ts",
    "test:http": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server --test --test-concurrency=1 tests/http/*.test.ts",
    "audit:gate": "node scripts/audit-gate.mjs",
    "deps:age": "node scripts/check-dependency-age.mjs",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "setup:env": "node scripts/dev/init-env.mjs",
    "db:up": "docker compose --env-file .env.local -f compose.yaml -f compose.dev.yaml up -d --wait db",
    "db:down": "docker compose --env-file .env.local -f compose.yaml -f compose.dev.yaml down",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:test:up": "docker compose -f compose.test.yaml up -d --wait",
    "db:test:down": "docker compose -f compose.test.yaml down",
    "user:create-admin": "node --env-file-if-exists=.env.local scripts/users/create-admin.mjs",
    "data:purge": "node --env-file-if-exists=.env.local scripts/data/purge.mjs",
    "data:export": "node --env-file-if-exists=.env.local scripts/data/export.mjs",
    "ai:evaluate": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server scripts/ai/evaluate.ts",
    "test:e2e": "playwright test",
    "test:ai-live": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server --test tests/ai-live-smoke.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1152.0",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "nodemailer": "10.1.0",
    "openai": "7.34.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "0.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "typescript": "^5.9.3"
  }
}
