/public/themes/

# Local working documents for the remediation
/DEMANDAI_*

# IDE and tool artefacts
.idea/
.playwright-mcp/

# End-to-end test output and the local sessions it keeps
/e2e/.state/
/test-results/
/playwright-report/
/blob-report/

# Environment files hold secrets; only the template is tracked
.env*
!.env.example

# Personal editor settings (MCP servers, local paths)
.vscode/
