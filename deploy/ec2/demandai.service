# DemandAI on an EC2 host: the Compose stack, started at boot after the env file is refreshed from AWS Secrets
# Manager. A restart is a redeploy: backup (local database), migrate, then the app is recreated if its image changed.
# Install: docs/devops/DEPLOY-EC2.md. The repository is checked out at /opt/demandai (only the compose files, db/ and
# deploy/ are used; the image is pulled, never built here).
[Unit]
Description=DemandAI (Docker Compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/demandai
# DEMANDAI_SECRET_ID, AWS_REGION, and DEMANDAI_COMPOSE_EXTRA ("-f deploy/ec2/compose.rds.yaml" with RDS, else empty).
EnvironmentFile=/etc/demandai/sync.conf
ExecStartPre=/opt/demandai/deploy/ec2/sync-secrets.sh
ExecStart=/usr/bin/docker compose -p demandai -f compose.yaml -f deploy/ec2/compose.proxy.yaml $DEMANDAI_COMPOSE_EXTRA --env-file /etc/demandai/demandai.env up -d --no-build --remove-orphans
ExecStop=/usr/bin/docker compose -p demandai -f compose.yaml -f deploy/ec2/compose.proxy.yaml $DEMANDAI_COMPOSE_EXTRA --env-file /etc/demandai/demandai.env stop
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
